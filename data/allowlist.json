  "_comment": "Guardrails. The orchestrator refuses any plan that falls outside these lists. Edit to match your real suites, pages and environments.",
  "suites": ["feds-unav"],
  "environments": ["stage", "prod"],
  "confirmEnvironments": ["prod"],
  "browsers": ["chrome", "firefox", "webkit"],
  "devices": ["desktop", "mobile"],
